{
  "name": "biblefeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted family Bible feed PWA",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "invite": "node --disable-warning=ExperimentalWarning scripts/create-invite.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0"
  }
}
